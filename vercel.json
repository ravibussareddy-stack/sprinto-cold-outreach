{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/run_case.py": {
      "maxDuration": 300
    },
    "api/redraft.py": {
      "maxDuration": 120
    },
    "api/cron_check_replies.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron_check_replies",
      "schedule": "0 4 * * *"
    }
  ]
}

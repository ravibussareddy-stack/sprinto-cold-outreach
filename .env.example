# --- LLM (Google Gemini) ---
GEMINI_API_KEY1=                # from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY2=                # optional fallback keys, used when a key runs out of quota
GEMINI_API_KEY3=
GEMINI_MODEL=gemini-3.8-flash   # check ai.google.dev for the current model list

# --- Storage (Neon Postgres) ---
NEON_DATABASE_URL=              # postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- PoC lookup ---
HUNTER_API_KEY=                 # Option A. Leave blank to use poc_overrides.json (Option B / Apollo)

# --- Sending (Gmail) ---
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=             # Google Account > Security > 2-Step Verification > App passwords
SEND_TO=you@gmail.com           # hard-coded: your OWN inbox, never the prospect
SENDER_NAME=Your Name, Sprinto

USE_JINA_FALLBACK=1

# --- Scheduling (Sequence 2) ---
SLOT_TIMEZONE=Asia/Kolkata
CALENDAR_BUSY_FILE=             # JSON list of busy [start, end] ISO intervals; blank = no calendar access
REPLIES_DIR=replies             # prospect replies: replies/<domain>.txt, blocks separated by a line ---
